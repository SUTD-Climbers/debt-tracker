# storage backend choice: "local_csv" or "google_sheets"
backend = "local_csv"

# gym pass default pricing (optional, can be overridden per member tier)
price_per_pass = 16.0

[auth]
# exco user accounts with bcrypt hashed passwords
# generate hashes using tools/make_password_hash.py
[auth.users]
exco_admin = "$2b$12$e868k.o4c0vEFrk1Hw9V.OGhG7J8hM0mO7rGvG8Kx8kO0rGvG8Kx8"

[google_sheets]
# required only when backend = "google_sheets"
spreadsheet_id = "your_google_spreadsheet_id_here"

# service account json credentials as an inline table
[google_sheets.service_account]
type = "service_account"
project_id = "your-gcp-project-id"
private_key_id = "your_private_key_id"
private_key = "-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
client_email = "your-service-account@your-gcp-project.iam.gserviceaccount.com"
client_id = "123456789012345678901"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "https://www.googleapis.com/robot/v1/metadata/x509/your-service-account..."
